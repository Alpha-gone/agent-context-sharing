# 개발 환경 기본값. 복사해 .env로 쓴다. .env는 .gitignore 대상이다.

# 접속 정보
POSTGRES_USER=agent_context
POSTGRES_PASSWORD=agent_context
POSTGRES_DB=agent_context
POSTGRES_PORT=5432
DATABASE_URL=postgres://agent_context:agent_context@localhost:5432/agent_context

# 통합 테스트 접속 정보. DATABASE_URL과 같은 개발 데이터베이스를 쓰며, .env를 현재
# 셸에 내보낸 뒤 go test ./...를 실행하면 실제 AGE 통합 테스트를 건너뛰지 않는다.
TEST_DATABASE_URL=postgres://agent_context:agent_context@localhost:5432/agent_context
TEST_DATABASE_REQUIRED=1

# 배포 구성 값. SDD.md의 「배포 구성」이 여는 값이며 아래는 개발 기본값일 뿐
# 명세가 고정한 값이 아니다.

# HTTP 서버가 수신할 주소다. /healthz와 /readyz를 포함한 모든 애플리케이션 경로가
# 이 주소에서 제공된다.
HTTP_ADDR=:8080

# AGE 그래프 이름. 「물리 배치」가 인스턴스 안에서 하나로 고정한다.
AGE_GRAPH_NAME=agent_context

# 임베딩 제공자, 모델과 차원. SRS의 「임베딩 모델」이 셋 다 배포 구성 값으로 두었고
# 개발 계획 0단계가 이 배포에 쓸 값으로 아래를 정했다. 자체 호스팅이므로 body와
# 질의 텍스트가 격리 경계를 나가지 않는다. 모델을 바꾸면 그래프 전체를 재색인한다.
# 모델 준비: docker compose up -d ollama && docker compose exec ollama ollama pull bge-m3
OLLAMA_PORT=11434
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# 임베딩 벡터 저장 타입과 차원. 「임베딩 스키마」가 vector, halfvec, bit 중에서
# 고르게 두었고 차원은 임베딩 모델이 정한다. bge-m3의 출력이 1024차원이며
# pgvector의 HNSW 인덱스 상한이 vector 기준 2000차원이라 그대로 인덱싱할 수 있다.
# 이 두 값은 마이그레이션에 치환되므로 바꾸면 001의 체크섬이 달라진다.
EMBEDDING_VECTOR_TYPE=vector
EMBEDDING_DIMENSION=1024

# 등록 클라이언트와 redirect_uri 허용 목록. 「인가 코드 흐름」이 사전 등록을
# 확정했고 등록되지 않은 client_id와 목록에 없는 redirect_uri를 거부한다.
# 여러 값은 쉼표로 나누며 루프백 주소는 포트를 제외하고 일치시킨다.
OAUTH_CLIENT_IDS=agent-context-dev
OAUTH_REDIRECT_URIS=http://127.0.0.1/callback

# 새 계정 비밀번호 해시에 쓸 bcrypt 비용 계수다. 기존 해시는 문자열 안의 비용 계수로
# 검증되므로 이 값을 올려도 새 등록부터 적용된다.
BCRYPT_COST=12

# TLS 종단 배치. FR-AGENT_CONTEXT-140이 평문 요청 처리를 금지하는데 역방향 프록시에서
# 종단하면 애플리케이션에 닿는 연결은 평문이므로 X-Forwarded-Proto로 판정한다.
# direct로 두면 앱이 TLS를 직접 받고 연결 자체로 판정한다.
TLS_TERMINATION=proxy

# 전달 헤더를 신뢰할 역방향 프록시의 주소 대역이다. X-Forwarded-Proto는 누구나 붙일 수
# 있으므로 이 목록에 든 상대가 보낸 요청에서만 그 헤더를 읽는다. 목록이 비어 있으면 어떤
# 전달 헤더도 신뢰하지 않으며, 이 값이 곧 평문 요청을 걸러 내는 유일한 관문이다.
# 실제 프록시가 앱에 접속하는 주소만 좁게 적는다. 넓게 잡으면 그만큼 위조를 허용한다.
# 대역과 단일 주소를 함께 쓸 수 있고 여러 값은 쉼표로 나눈다. 호스트 비트가 남은
# 대역(10.0.0.1/8)은 거부하므로 10.0.0.0/8처럼 정규화해 적는다.
# TLS_TERMINATION=direct일 때는 비워 둔다.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# 앱이 TLS를 직접 종단할 때 쓸 인증서와 개인 키 파일이다. TLS_TERMINATION=direct일
# 때 둘 다 필요하며, 프록시 종단 배치에서는 비워 둔다.
TLS_CERT_FILE=
TLS_KEY_FILE=
