# 개발 환경 기본값. 복사해 .env로 쓴다. .env는 .gitignore 대상이다.

# 접속 정보
POSTGRES_USER=agent_context
POSTGRES_PASSWORD=agent_context
POSTGRES_DB=agent_context
POSTGRES_PORT=5432
DATABASE_URL=postgres://agent_context:agent_context@localhost:5432/agent_context

# 통합 테스트 접속 정보. DATABASE_URL과 같은 개발 데이터베이스를 쓰며, .env를 현재
# 셸에 내보낸 뒤 go test ./...를 실행하면 실제 AGE 통합 테스트를 건너뛰지 않는다.
TEST_DATABASE_URL=postgres://agent_context:agent_context@localhost:5432/agent_context
TEST_DATABASE_REQUIRED=1

# 배포 구성 값. SDD.md의 「배포 구성」이 여는 값이며 아래는 개발 기본값일 뿐
# 명세가 고정한 값이 아니다.

# HTTP 서버가 수신할 주소다. /healthz와 /readyz를 포함한 모든 애플리케이션 경로가
# 이 주소에서 제공된다.
HTTP_ADDR=:8080

# AGE 그래프 이름. 「물리 배치」가 인스턴스 안에서 하나로 고정한다.
AGE_GRAPH_NAME=agent_context

# 임베딩 제공자, 모델과 차원. SRS의 「임베딩 모델」이 셋 다 배포 구성 값으로 두었고
# 개발 계획 0단계가 이 배포에 쓸 값으로 아래를 정했다. 자체 호스팅이므로 body와
# 질의 텍스트가 격리 경계를 나가지 않는다. 모델을 바꾸면 그래프 전체를 재색인한다.
# 모델 준비: docker compose up -d ollama && docker compose exec ollama ollama pull bge-m3
OLLAMA_PORT=11434
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# 임베딩 벡터 저장 타입과 차원. 「임베딩 스키마」가 vector, halfvec, bit 중에서
# 고르게 두었고 차원은 임베딩 모델이 정한다. bge-m3의 출력이 1024차원이며
# pgvector의 HNSW 인덱스 상한이 vector 기준 2000차원이라 그대로 인덱싱할 수 있다.
# 이 두 값은 마이그레이션에 치환되므로 바꾸면 001의 체크섬이 달라진다.
EMBEDDING_VECTOR_TYPE=vector
EMBEDDING_DIMENSION=1024

# 검색 진입 채널의 실행 방식, 각 채널이 결합 단계에 넘길 후보 수 상한과 의미 유사도
# 하한이다. 기본 실행은 병렬이며, 순차를 선택해도 후보 목록과 결합 결과는 같다. 유사도
# 하한은 auto 범위에서 관련 국소 후보가 있는지 판정하며 검색 품질 평가로 조정한다.
SEARCH_CHANNEL_EXECUTION=parallel
SEARCH_CHANNEL_CANDIDATE_LIMIT=50
SEARCH_SEMANTIC_SIMILARITY_THRESHOLD=0.50

# 국소 그래프 경로의 누적 범위와 auto의 전역 요약 전환 여부다. 본 측정에서 국소 그래프
# 확장은 유의한 품질 개선 없이 지연을 늘렸고 전역 전환은 유의하게 개선됐으므로, 국소
# 그래프는 baseline으로 끄고 전역 전환만 켠다. 호출자가 scope=global로 명시한 진입점
# 선택은 이 값들이 끄지 않는다.
SEARCH_GRAPH_STAGE=baseline
SEARCH_GLOBAL_FALLBACK_ENABLED=true

# 색인 작업으로 등록할 계층 범위다. 「색인 대상 비교」가 원천을 포함한 구성과 파생·사건만
# 담은 구성을 비교하라고 했다. 본 측정에서 원천 제외가 공개 세트의 사실·연상 재현율을
# 유의하게 낮췄으므로 원천을 포함하는 all_layers를 유지한다. 값을 바꾸면 그래프를
# 재색인해야 이전 구성이 남긴 임베딩이 정리된다.
INDEX_TARGET_LAYERS=all_layers

# 등록 클라이언트와 클라이언트별 redirect_uri 허용 목록이다. 「인가 코드 흐름」이 사전 등록을
# 확정했고 등록되지 않은 client_id와 그 클라이언트의 목록에 없는 redirect_uri를 거부한다.
# 값은 클라이언트를 키로 하는 JSON 객체이며 루프백 주소는 포트를 제외하고 일치시킨다.
OAUTH_CLIENTS={"agent-context-dev":["http://127.0.0.1/callback"]}

# 색인 작업자와 인가 서버의 배치. 「배치 조합」이 네 조합을 열어 두었고 둘 다 내장이
# 기본값이다. external로 두면 이 인스턴스는 색인 작업 큐를 소비하지 않거나 인가 서버
# 경로를 등록하지 않으며, 그 구성 요소는 다른 배포 단위가 맡는다. 질의 임베딩과 이미
# 발급된 토큰의 검증은 배치와 무관하게 이 인스턴스가 계속 수행한다.
INDEX_WORKER_PLACEMENT=embedded
AUTHORIZATION_SERVER_PLACEMENT=embedded

# MCP 리소스 서버와 인가 서버의 공개 주소, 그리고 MCP 요청에서 허용할 Origin 목록이다.
# RESOURCE_SERVER_URL은 반드시 /mcp 경로여야 하며, 나머지 두 값은 scheme과 host만 둔다.
# 여러 Origin은 쉼표로 구분한다. 요청 Host에서 이 값을 유도하지 않아 토큰 aud와 discovery
# 문서가 프록시·요청 헤더에 따라 바뀌지 않게 한다.
RESOURCE_SERVER_URL=https://localhost:8080/mcp
AUTHORIZATION_SERVER_URL=https://localhost:8080
MCP_ALLOWED_ORIGINS=https://localhost:8080

# 사건 관계 후보 제안의 임계값과 후보 수 상한이다. 「사건 관계 후보 제안」이 값의 조정을
# 「검색 품질 평가」에 맡기면서 시작값을 배포 구성에 두기로 확정했다. 아래 세 값은 모두
# 시작값이며 측정 근거는 아직 없다.
#
# RELATION_ADJACENCY_WINDOW는 precedes 후보로 올릴 두 사건 사이의 최대 간격이다. 시간
# 범위가 겹치지 않고 이 간격 안에 있는 사건만 후보가 된다. Go의 기간 표기를 쓴다.
# RELATION_SIMILARITY_THRESHOLD는 relates_to 후보로 올릴 코사인 유사도의 하한이다.
# RELATION_PROPOSAL_LIMIT은 한 사건이 한 번의 제안에서 신호마다 만들 수 있는 후보 수다.
RELATION_ADJACENCY_WINDOW=1h
RELATION_SIMILARITY_THRESHOLD=0.80
RELATION_PROPOSAL_LIMIT=10

# 중복 파생 접기의 유사 판정 임계값이다. 근거 집합과 종류, 근거 상태가 같은 파생끼리만
# 비교하며 body의 문자 삼중자 자카드 유사도가 이 값 이상이면 순위가 높은 쪽으로 접는다.
# 1이면 완전히 같은 본문만 접힌다. 시작값이며 측정 근거는 아직 없고 조정은
# 「검색 품질 평가」가 맡는다.
SEARCH_FOLD_SIMILARITY_THRESHOLD=0.90

# 새 계정 비밀번호 해시에 쓸 bcrypt 비용 계수다. 기존 해시는 문자열 안의 비용 계수로
# 검증되므로 이 값을 올려도 새 등록부터 적용된다.
BCRYPT_COST=12

# 계정별 플랜 값이다. 계정 UUIDv7를 키로 하는 JSON 객체이며, 계정 값에는 바꿀 항목만
# 넣는다. 없는 항목은 plan.Default()의 값을 쓰고, 비어 있으면 모든 계정이 기본값을 쓴다.
# 예: ACCOUNT_PLAN_LIMITS='{"0198e7c0-0000-7000-8000-000000000001":{"max_hops":6,"context_budget":30000,"graph_page":{"default":100,"maximum":300}}}'
ACCOUNT_PLAN_LIMITS=

# TLS 종단 배치. FR-AGENT_CONTEXT-140이 평문 요청 처리를 금지하는데 역방향 프록시에서
# 종단하면 애플리케이션에 닿는 연결은 평문이므로 X-Forwarded-Proto로 판정한다.
# direct로 두면 앱이 TLS를 직접 받고 연결 자체로 판정한다.
TLS_TERMINATION=proxy

# 전달 헤더를 신뢰할 역방향 프록시의 주소 대역이다. X-Forwarded-Proto는 누구나 붙일 수
# 있으므로 이 목록에 든 상대가 보낸 요청에서만 그 헤더를 읽는다. 목록이 비어 있으면 어떤
# 전달 헤더도 신뢰하지 않으며, 이 값이 곧 평문 요청을 걸러 내는 유일한 관문이다.
# 실제 프록시가 앱에 접속하는 주소만 좁게 적는다. 넓게 잡으면 그만큼 위조를 허용한다.
# 대역과 단일 주소를 함께 쓸 수 있고 여러 값은 쉼표로 나눈다. 호스트 비트가 남은
# 대역(10.0.0.1/8)은 거부하므로 10.0.0.0/8처럼 정규화해 적는다.
# TLS_TERMINATION=direct일 때는 비워 둔다.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# 앱이 TLS를 직접 종단할 때 쓸 인증서와 개인 키 파일이다. TLS_TERMINATION=direct일
# 때 둘 다 필요하며, 프록시 종단 배치에서는 비워 둔다.
TLS_CERT_FILE=
TLS_KEY_FILE=
