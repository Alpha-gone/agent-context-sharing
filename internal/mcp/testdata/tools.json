          },
          "name": {
            "description": "New nonblank name; omit to keep.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 16,
            "type": "string"
          }
        },
        "required": [
          "graph_id",
          "expected_version"
        ],
        "type": "object"
      },
      "name": "graph_update"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Create a source, derived node or event. A creation_status=existing_deleted result cannot be active evidence. Connect events with previous_event_id or relation_confirm.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "format": "uuid-v7",
            "type": "string"
          },
          "body": {
            "description": "Body; no NUL, whitespace-only allowed. Stored and indexed verbatim.",
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "confidence_state": {
            "description": "Confidence state: required for opinion; forbidden otherwise.",
            "enum": [
              "supported",
              "uncertain",
              "disputed"
            ],
            "type": "string"
          },
          "conversation_id": {
            "description": "Immutable nonblank conversation ID for sources and events. Sources require channel=conversation and turn_index.",
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "derivation_kind": {
            "description": "Immutable derivation purpose.",
            "enum": [
              "proposition",
              "summary",
              "reflection"
            ],
            "type": "string"
          },
          "derived_from": {
            "description": "Immutable source/derived evidence references in the same graph.",
            "items": {
              "format": "uuid-v7",
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
          },
          "event_end": {
            "description": "Event end in UTC; omit for ongoing.",
            "format": "date-time",
            "type": "string"
          },
          "event_start": {
            "description": "Event start in UTC. Source members must occur within the event interval.",
            "format": "date-time",
            "type": "string"
          },
          "evidence_state": {
            "description": "Immutable evidence category.",
            "enum": [
              "observation",
              "experience",
              "opinion"
            ],
            "type": "string"
          },
          "graph_id": {
            "format": "uuid-v7",
            "type": "string"
          },
          "judgment_input": {
            "description": "Judgment input; omit to record validated arguments.",
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "layer": {
            "description": "Required by layer: source: source_ref, occurred_at, origin_kind; derived: derived_from, derivation_kind, evidence_state; event: member_refs, event_start. Reject fields belonging to other layers.",
            "enum": [
              "source",
              "derived",
              "event"
            ],
            "type": "string"
          },
          "member_refs": {
            "description": "Source/derived members in the same graph; no events.",
            "items": {
              "format": "uuid-v7",
              "type": "string"
            },
            "maxItems": 1000,
            "minItems": 1,
            "type": "array"
          },
          "navigation_refs": {
            "description": "Immutable summary navigation, not evidence: events, summaries or sources in the same graph. No self-reference.",
            "items": {
              "format": "uuid-v7",
              "type": "string"
            },
            "maxItems": 100,
            "type": "array",
            "uniqueItems": true
          },
          "occurred_at": {
            "description": "Original occurrence time in UTC, distinct from recording time.",
            "format": "date-time",
            "type": "string"
          },
          "origin_kind": {
            "description": "Immutable origin category.",
            "enum": [
              "user_utterance",
              "agent_output",
              "external_content"
            ],
            "type": "string"
          },
          "previous_event_id": {
            "description": "Event only: active previous event in the same graph and conversation. Requires conversation_id. Atomically creates confirmed precedes; not stored as a property.",
            "format": "uuid-v7",
            "type": "string"
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 16,
            "type": "string"
          },
          "source_ref": {
            "additionalProperties": false,
            "description": "Source deduplication key. Returns existing sources even if discarded/deleted; never restores automatically.",
            "properties": {
              "channel": {
                "description": "Collection channel, separate from origin_kind.",
                "enum": [
                  "conversation",
                  "file",
                  "web",
                  "api",
                  "other"
                ],
                "type": "string"
              },
              "locator": {
                "description": "Original URI; the server does not fetch it.",
                "format": "uri",
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "channel",
              "locator"
            ],
            "type": "object"
          },
          "summary_scope": {
            "description": "Summary scope: required for summary; forbidden otherwise.",
            "enum": [
              "local",
              "global"
            ],
            "type": "string"
          },
          "supersedes_context_id": {
            "description": "Prior derived node in the same lineage. Edge: new to prior; separate from evidence.",
            "format": "uuid-v7",
            "type": "string"
          },
          "turn_index": {
            "description": "Immutable conversation source turn order; paired with conversation_id.",
            "minimum": 0,
            "type": "integer"
          },
          "valid_from": {
            "description": "Derived validity start in UTC; omit for open start.",
            "format": "date-time",
            "type": "string"
          },
          "valid_to": {
            "description": "Derived validity end in UTC; omit for open end.",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "graph_id",
          "layer",
          "body",
          "agent_id"
        ],
        "type": "object"
      },
      "name": "node_create"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Get a subgraph via confirmed edges. Truncation is a normal partial result.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "context_id": {
            "format": "uuid-v7",
            "type": "string"
          },
          "direction": {
            "description": "Default both. out follows derived to evidence/prior, summary to navigation, event to members/relation targets; in reverses.",
            "enum": [
              "in",
              "out",
              "both"
            ],
            "type": "string"
          },
          "graph_id": {
            "format": "uuid-v7",
            "type": "string"
          },
          "hops": {
            "description": "Hop count; default 0 returns only the start. Maximum depends on plan.",
            "minimum": 0,
            "type": "integer"
          },
          "traversal_filter": {
            "description": "Edge filter; omit or empty for all. Duplicates allowed.",
            "items": {
              "enum": [
                "derived_from",
                "supersedes",
                "member_refs",
                "navigation_refs",
                "precedes",
                "causes",
                "part_of",
                "relates_to"
              ],
              "type": "string"
            },
            "maxItems": 8,
            "type": "array"
          }
        },
        "required": [
          "graph_id",
          "context_id"
        ],
        "type": "object"
      },
      "name": "node_get"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Update mutable derived/event fields or record a keep judgment. Sources are immutable; correct them with new sources. To change derived evidence/kind, create a replacement with supersedes_context_id. Omitted fields stay unchanged.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "format": "uuid-v7",
            "type": "string"
          },
          "body": {
            "description": "Body; no NUL, whitespace-only allowed. Stored and indexed verbatim.",
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "confidence_state": {
            "description": "New confidence for an opinion derived node.",
            "enum": [
              "supported",
              "uncertain",
              "disputed"
            ],
            "type": "string"
          },
          "context_id": {
            "format": "uuid-v7",
            "type": "string"
          },
          "event_end": {
            "description": "New event end in UTC; null for ongoing.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "event_start": {
            "description": "New event start in UTC; source members must occur within the interval.",
            "format": "date-time",
            "type": "string"
          },
          "expected_version": {
            "minimum": 1,
            "type": "integer"
          },
          "graph_id": {
            "format": "uuid-v7",
            "type": "string"
          },
          "judgment_input": {
            "description": "Judgment input; omit to record validated arguments.",
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "management_action": {
            "description": "Default update. keep checks the current version and records judgment without mutable fields.",
            "enum": [
              "update",
              "keep"
            ],
            "type": "string"
          },
          "member_refs": {
            "description": "Replacement source/derived members; no events.",
            "items": {
              "format": "uuid-v7",
              "type": "string"
            },
            "maxItems": 1000,
            "minItems": 1,
            "type": "array"
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 16,
            "type": "string"
          },
          "valid_from": {
            "description": "New derived validity start in UTC; null to clear.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "valid_to": {
            "description": "New derived validity end in UTC; null to clear.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "graph_id",
          "context_id",
          "expected_version",
          "agent_id"
        ],
        "type": "object"
      },
      "name": "node_update"
    },
