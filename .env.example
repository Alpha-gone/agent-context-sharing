# 개발 환경 기본값. 복사해 .env로 쓴다. .env는 .gitignore 대상이다.

# 접속 정보
POSTGRES_USER=agent_context
POSTGRES_PASSWORD=agent_context
POSTGRES_DB=agent_context
POSTGRES_PORT=5432
DATABASE_URL=postgres://agent_context:agent_context@localhost:5432/agent_context

# 배포 구성 값. SDD.md의 「배포 구성」이 여는 값이며 아래는 개발 기본값일 뿐
# 명세가 고정한 값이 아니다.

# AGE 그래프 이름. 「물리 배치」가 인스턴스 안에서 하나로 고정한다.
AGE_GRAPH_NAME=agent_context

# 임베딩 제공자, 모델과 차원. SRS의 「임베딩 모델」이 셋 다 배포 구성 값으로 두었고
# 개발 계획 0단계가 이 배포에 쓸 값으로 아래를 정했다. 자체 호스팅이므로 body와
# 질의 텍스트가 격리 경계를 나가지 않는다. 모델을 바꾸면 그래프 전체를 재색인한다.
# 모델 준비: docker compose up -d ollama && docker compose exec ollama ollama pull bge-m3
OLLAMA_PORT=11434
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# 임베딩 벡터 저장 타입과 차원. 「임베딩 스키마」가 vector, halfvec, bit 중에서
# 고르게 두었고 차원은 임베딩 모델이 정한다. bge-m3의 출력이 1024차원이며
# pgvector의 HNSW 인덱스 상한이 vector 기준 2000차원이라 그대로 인덱싱할 수 있다.
# 이 두 값은 마이그레이션에 치환되므로 바꾸면 001의 체크섬이 달라진다.
EMBEDDING_VECTOR_TYPE=vector
EMBEDDING_DIMENSION=1024

# 등록 클라이언트와 redirect_uri 허용 목록. 「인가 코드 흐름」이 사전 등록을
# 확정했고 등록되지 않은 client_id와 목록에 없는 redirect_uri를 거부한다.
# 여러 값은 쉼표로 나누며 루프백 주소는 포트를 제외하고 일치시킨다.
OAUTH_CLIENT_IDS=agent-context-dev
OAUTH_REDIRECT_URIS=http://127.0.0.1/callback

# TLS 종단 배치와 전달 헤더 신뢰 여부. FR-AGENT_CONTEXT-140이 평문 요청 처리를
# 금지하는데 역방향 프록시에서 종단하면 애플리케이션에 닿는 연결은 평문이므로
# X-Forwarded-Proto로 판정한다. 이 헤더는 클라이언트가 위조할 수 있어 프록시
# 뒤에 있을 때만 신뢰한다. 앱이 직접 종단하면 false로 두고 연결 자체로 판정한다.
TLS_TERMINATION=proxy
TRUST_FORWARDED_PROTO=true
