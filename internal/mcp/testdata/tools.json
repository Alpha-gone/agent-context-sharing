    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Confirm/reconfirm relations between active events in one graph. Use derived_from/member_refs for source/derived links. Failure does not undo prior node creation.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "format": "uuid-v7",
