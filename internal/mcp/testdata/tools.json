{
  "instructions": "Shared context graphs: search with context_flow_get; choose graph_list. Before node/relation writes, get agent_id via agent_register; reuse registration keys per account/OAuth client. Registration grants no identity proof/access.\ngraph_update/node_update need current expected_version; reread on conflict. Keys use only ASCII letters, digits, _ or -. request_id is an optional per-write key: same key+args replay for 24 hours; new key=new write. Lost key/uncertain unkeyed result: reread. Internal failure: no relogin.\nServer auth/grade/agent checks apply; annotations/host approval grant no access. Delete/permissions/teams are web-only.",
  "protocolVersion": "2026-07-28",
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Register an agent. Reusing an active key returns the same ID; revoked keys stay revoked.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "registration_key": {
            "description": "Reusable key: 16-128 ASCII letters, digits, _ or -. Never include credentials or content.",
            "maxLength": 128,
            "minLength": 16,
            "type": "string"
          }
        },
        "required": [
          "registration_key"
        ],
        "type": "object"
      },
      "name": "agent_register"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "List accessible active graphs by recent activity.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "description": "Reuse the returned cursor unchanged. Omit or empty for the first page.",
            "format": "base64url",
            "type": "string"
          },
          "grade_filter": {
            "description": "Filter by current grade. Empty and duplicate values allowed.",
            "items": {
              "enum": [
                "owner",
                "editor",
                "viewer"
              ],
              "type": "string"
            },
            "maxItems": 3,
            "type": "array"
          },
          "name_filter": {
            "description": "Case-insensitive name substring.",
            "type": "string"
          },
          "page_size": {
            "description": "Page size; default and maximum depend on plan.",
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "name": "graph_list"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Create a graph owned by the authenticated account.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "description": "Description; may be empty.",
            "maxLength": 2000,
            "type": "string"
          },
          "name": {
            "description": "Display name; nonblank, duplicates allowed.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 16,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "name": "graph_create"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Get graph metadata, current version and entry summary.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "graph_id": {
            "format": "uuid-v7",
            "type": "string"
          }
        },
        "required": [
          "graph_id"
        ],
        "type": "object"
      },
      "name": "graph_get"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Update name, description or entry summary using the current expected_version.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "description": "New description; omit to keep, empty to clear.",
            "maxLength": 2000,
            "type": "string"
          },
          "entry_context_id": {
            "description": "Active entry summary; omit to keep, null to clear.",
            "format": "uuid-v7",
