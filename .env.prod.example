# 운영 배포 예시. 서버에서 복사해 .env로 쓴다(cp .env.prod.example .env).
# compose.prod.yaml이 이 파일을 변수 치환과 애플리케이션 환경으로 함께 읽는다.
# 개발 기본값은 .env.example에 있으며 그 자격 증명을 여기에 쓰지 않는다.
#
# 아래 값은 compose.prod.yaml이 배치에 맞게 덮어쓰므로 여기에 적지 않는다.
#   DATABASE_URL         POSTGRES_* 값으로 db 서비스 주소를 만든다
#   HTTP_ADDR            컨테이너 안 :8080
#   TLS_TERMINATION      proxy. Cloudflare가 TLS를 종단하고 원본은 HTTP를 받는다
#   TRUSTED_PROXY_CIDRS  호스트 접속 경로 10.203.0.1/32만 신뢰하여 전달 헤더를 검증한다
#   TLS_CERT_FILE·TLS_KEY_FILE  빈 값. 원본 인증서·키를 사용하거나 마운트하지 않는다

# DB 자격 증명. POSTGRES_PASSWORD는 필수이며 DATABASE_URL에 그대로 들어가므로 영문·숫자로
# 길게 만든다. DB는 호스트에 공개하지 않는다.
POSTGRES_USER=agent_context
POSTGRES_PASSWORD=
POSTGRES_DB=agent_context

# 호스트의 cloudflared가 접속할 loopback HTTP 포트다. 원본 URL은 http://localhost:80이다.
# 포트를 바꾸면 커넥터의 원본 URL도 맞춘다. 외부 인터페이스에는 공개하지 않는다.
# Cloudflare와 커넥터 사이의 터널은 암호화되지만 로컬 HTTP 구간은 시험 운영 예외다.
# 공개 클라이언트 URL은 HTTPS로 유지한다. cloudflared는 Compose 밖에서 관리한다.
HTTP_PORT=80

AGE_GRAPH_NAME=agent_context

# Gemini 임베딩. body와 질의가 외부 API로 전송된다. API 키는 필수다.
# EMBEDDING_PROVIDER는 서버·평가·감사에서 반드시 명시한다.
EMBEDDING_PROVIDER=gemini
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com
EMBEDDING_MODEL=gemini-embedding-2
GEMINI_API_KEY=
EMBEDDING_VECTOR_TYPE=vector
EMBEDDING_DIMENSION=768
EMBEDDING_COLD_TABLESPACE=

# 공개 주소. 실제 터널의 HTTPS 도메인으로 바꾼다. RESOURCE_SERVER_URL은 /mcp 경로여야 한다.
RESOURCE_SERVER_URL=https://agent-context.example.com/mcp
AUTHORIZATION_SERVER_URL=https://agent-context.example.com
MCP_ALLOWED_ORIGINS=https://agent-context.example.com

# 등록 클라이언트와 redirect_uri. 클라이언트의 AGENT_CONTEXT_CLIENT_ID가 이 키와 같아야 한다.
OAUTH_CLIENTS='{"agent-context":["http://127.0.0.1/callback","http://[::1]/callback"]}'

# 검색 진입 채널의 실행 방식, 각 채널이 결합 단계에 넘길 후보 수 상한과 의미 유사도
# 하한이다. 기본 실행은 병렬이며, 순차를 선택해도 후보 목록과 결합 결과는 같다. 유사도
# 하한은 auto 범위에서 관련 국소 후보가 있는지 판정하며 검색 품질 평가로 조정한다.
SEARCH_CHANNEL_EXECUTION=parallel
SEARCH_CHANNEL_CANDIDATE_LIMIT=50
SEARCH_SEMANTIC_SIMILARITY_THRESHOLD=0.50

# 국소 그래프 경로의 누적 범위와 auto의 전역 요약 전환 여부다. 본 측정에서 국소 그래프
# 확장은 유의한 품질 개선 없이 지연을 늘렸고 전역 전환은 유의하게 개선됐으므로, 국소
# 그래프는 baseline으로 끄고 전역 전환만 켠다. 호출자가 scope=global로 명시한 진입점
# 선택은 이 값들이 끄지 않는다.
SEARCH_GRAPH_STAGE=baseline
SEARCH_GLOBAL_FALLBACK_ENABLED=true

# 근거 경로 보존 선택 활성 여부다. 켜면 통합 후보를 진입점까지 이어지는 연결 근거 집합으로
# 묶어 집합 단위로 예산을 적용하고, 끄면 기존 통합 순위 절단을 수행한다. 비우면 false다.
# 통제 비교에서 근거 완전성·경로 연속성·예산 효율이 유의하게 개선되지 않아 끈다.
SEARCH_EVIDENCE_PATH_SELECTION_ENABLED=false

# scope=auto의 질의 적응형 라우팅 활성 여부와 직접 경로 판정 임계값이다. 켜면 진입 채널
# 결과로 직접, 국소 확장(최대 1홉), 전역 진입 중 하나를 고르고 SEARCH_GLOBAL_FALLBACK_ENABLED를
# 보지 않는다. 켤 때는 SEARCH_GRAPH_STAGE가 baseline이 아니어야 하고 두 임계값이 필요하다.
# 비우면 false이며 두 임계값은 켤 때만 읽는다. 통제 비교에서 사건 세트의 연상 품질이
# 어느 임계값에서도 떨어져 끄고, 쓰이지 않는 두 임계값은 정하지 않는다.
SEARCH_QUERY_ADAPTIVE_ROUTING_ENABLED=false
SEARCH_ADAPTIVE_DIRECT_SIMILARITY_THRESHOLD=
SEARCH_ADAPTIVE_DIRECT_MARGIN_THRESHOLD=

# 색인 작업으로 등록할 계층 범위다. 「색인 대상 비교」가 원천을 포함한 구성과 파생·사건만
# 담은 구성을 비교하라고 했다. 본 측정에서 원천 제외가 공개 세트의 사실·연상 재현율을
# 유의하게 낮췄으므로 원천을 포함하는 all_layers를 유지한다. 값을 바꾸면 그래프를
# 재색인해야 이전 구성이 남긴 임베딩이 정리된다.
INDEX_TARGET_LAYERS=all_layers

# 색인 작업자와 인가 서버의 배치. 「배치 조합」이 네 조합을 열어 두었고 둘 다 내장이
# 기본값이다. external로 두면 이 인스턴스는 색인 작업 큐를 소비하지 않거나 인가 서버
# 경로를 등록하지 않으며, 그 구성 요소는 다른 배포 단위가 맡는다. 질의 임베딩과 이미
# 발급된 토큰의 검증은 배치와 무관하게 이 인스턴스가 계속 수행한다.
INDEX_WORKER_PLACEMENT=embedded
AUTHORIZATION_SERVER_PLACEMENT=embedded

# 사건 관계 후보 제안의 임계값과 후보 수 상한이다. 「사건 관계 후보 제안」이 값의 조정을
# 「검색 품질 평가」에 맡기면서 시작값을 배포 구성에 두기로 확정했다. 아래 세 값은 모두
# 시작값이며 측정 근거는 아직 없다.
#
# RELATION_ADJACENCY_WINDOW는 precedes 후보로 올릴 두 사건 사이의 최대 간격이다. 시간
# 범위가 겹치지 않고 이 간격 안에 있는 사건만 후보가 된다. Go의 기간 표기를 쓴다.
# RELATION_SIMILARITY_THRESHOLD는 relates_to 후보로 올릴 코사인 유사도의 하한이다.
# RELATION_PROPOSAL_LIMIT은 한 사건이 한 번의 제안에서 신호마다 만들 수 있는 후보 수다.
RELATION_ADJACENCY_WINDOW=1h
RELATION_SIMILARITY_THRESHOLD=0.80
RELATION_PROPOSAL_LIMIT=10

# 중복 파생 접기의 유사 판정 임계값이다. 근거 집합과 종류, 근거 상태가 같은 파생끼리만
# 비교하며 body의 문자 삼중자 자카드 유사도가 이 값 이상이면 순위가 높은 쪽으로 접는다.
# 1이면 완전히 같은 본문만 접힌다. 시작값이며 측정 근거는 아직 없고 조정은
# 「검색 품질 평가」가 맡는다.
SEARCH_FOLD_SIMILARITY_THRESHOLD=0.90

# 새 계정 비밀번호 해시에 쓸 bcrypt 비용 계수다. 기존 해시는 문자열 안의 비용 계수로
# 검증되므로 이 값을 올려도 새 등록부터 적용된다.
BCRYPT_COST=12

# 계정별 플랜 값이다. 계정 UUIDv7를 키로 하는 JSON 객체이며, 계정 값에는 바꿀 항목만
# 넣는다. 없는 항목은 plan.Default()의 값을 쓰고, 비어 있으면 모든 계정이 기본값을 쓴다.
# 예: ACCOUNT_PLAN_LIMITS='{"0198e7c0-0000-7000-8000-000000000001":{"max_hops":6,"context_budget":30000,"graph_page":{"default":100,"maximum":300}}}'
ACCOUNT_PLAN_LIMITS=
